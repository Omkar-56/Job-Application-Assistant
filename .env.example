# Copy this file to .env and fill in your own values. .env is gitignored.

# Optional: only needed if you want unattended login. If left blank, the
# script will pause on a headed browser and let you log in manually (and
# optionally solve any 2FA/captcha), then save the session for next time.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# true/false — headless is the default for normal runs; Phase 1 defaults to
# headed (false) so you can watch what the browser is doing.
HEADLESS=false

# Max number of "load more" / pagination actions per search run.
MAX_PAGES=3

# --- Phase 3: PostgreSQL storage ---
# Connection string for your Postgres database. Never commit real
# credentials — this file is a template; your actual values go in .env,
# which is gitignored.
# Example: postgresql://myuser:mypassword@localhost:5432/job_assistant
DATABASE_URL=

# 'postgres' (default) or 'json' — use 'json' to fall back to the simple
# file-based store from Phase 1/2 without needing a database running.
STORAGE_BACKEND=postgres
