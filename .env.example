# Copy this file to .env and fill in your own values. .env is gitignored.

# Optional: only needed if you want unattended login. If left blank, the
# script will pause on a headed browser and let you log in manually (and
# optionally solve any 2FA/captcha), then save the session for next time.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# true/false — headless is the default for normal runs; Phase 1 defaults to
# headed (false) so you can watch what the browser is doing.
HEADLESS=false

# Max number of "load more" / pagination actions per search run.
MAX_PAGES=3

# --- Phase 3: PostgreSQL storage ---
# Connection string for your Postgres database. Never commit real
# credentials — this file is a template; your actual values go in .env,
# which is gitignored.
# Example: postgresql://myuser:mypassword@localhost:5432/job_assistant
DATABASE_URL=

# 'postgres' (default) or 'json' — use 'json' to fall back to the simple
# file-based store from Phase 1/2 without needing a database running.
STORAGE_BACKEND=postgres

# --- Phase 4: applying ---
# Safety switch. true (default) = Apply is never actually clicked; every
# action is logged as [DRY RUN] instead. Only set to false once you've
# watched a dry run and trust the selectors for your search.
DRY_RUN=true
# Caps how many jobs get applied to in a single run, so an unattended run
# can't apply to your whole filtered list at once. Run again to continue.
MAX_APPLICATIONS_PER_RUN=5

# --- Phase 6: AI matching ---
# Free key from https://aistudio.google.com/apikey — no credit card needed.
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash-lite (generous free quota, fast, JSON mode).
GEMINI_MODEL=gemini-2.5-flash-lite
# Path to your resume PDF, relative to the project root.
RESUME_PATH=resume.pdf
# Each unscored job costs one page load + one LLM call — kept small by default.
MATCH_MAX_PER_RUN=10
