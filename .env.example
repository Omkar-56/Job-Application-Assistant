# Optional: only needed if you want unattended login. If left blank, the
# script will pause on a headed browser and let you log in manually (and
# optionally solve any 2FA/captcha), then save the session for next time.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# true/false — headless is the default for normal runs; Phase 1 defaults to
# headed (false) so you can watch what the browser is doing.
HEADLESS=false

# Max number of "load more" / pagination actions per search run.
MAX_PAGES=3
